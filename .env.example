# ==========================================
# M-One Environment Variables Template (.env.example)
# Copie este arquivo para .env ou configure no painel da Vercel
# ==========================================

# Conexão PostgreSQL Supabase (Obrigatório Pooler IPv4 porta 6543)
DATABASE_URL=postgresql://postgres.[ref]:[sua-senha]@aws-0-us-west-2.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_URL=

# Chave Secreta de Sessão Flask (Gerar uma string aleatória forte)
SECRET_KEY=sua-chave-secreta-m-one-producao

# Google Gemini IA (Copilot)
GEMINI_API_KEY=sua-chave-api-gemini
GEMINI_MODEL=gemini-flash-latest

# Integração Bling ERP OAuth2
BLING_CLIENT_ID=seu-bling-client-id
BLING_CLIENT_SECRET=seu-bling-client-secret
BLING_ACCESS_TOKEN=
BLING_REFRESH_TOKEN=

# Meta WhatsApp Cloud API (Oficial)
WHATSAPP_TOKEN=seu-token-whatsapp-cloud-api
WHATSAPP_PHONE_NUMBER_ID=seu-phone-number-id
WHATSAPP_VERIFY_TOKEN=seu-webhook-verify-token
WHATSAPP_API_VERSION=v20.0

# Porta do Servidor Local (Padrão 5001 no macOS)
PORT=5001
