{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "templates/**",
          "routes/**",
          "services/**",
          "static/css/**",
          "static/js/**",
          "static/images/**",
          "static/*.css",
          "static/*.js",
          "static/*.png",
          "static/*.ico",
          "api/static/**",
          "public/**",
          "uploads/outlet/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/cron/prospector-sync",
      "schedule": "0 9 * * *"
    }
  ]
}
