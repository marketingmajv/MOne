{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": ["public/**", "static/**", "api/static/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/images/(.*)",
      "dest": "https://raw.githubusercontent.com/marketingmajv/MOne/main/public/images/$1",
      "status": 302
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
