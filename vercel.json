{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "redirects": [
    {
      "source": "/images/:path*",
      "destination": "https://raw.githubusercontent.com/marketingmajv/MOne/main/public/images/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
